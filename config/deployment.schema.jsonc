/**
 * Deployment contract — shared by ALL labels; carries NO values.
 *
 * This is the single place the *shape* and the *rules* of a complete
 * white-label tenant live: which keys exist, which class each key is
 * (build / api-var / api-secret / cf-resource / external), which
 * environment anchor it derives from, and any policy constraint. The
 * per-label *values* live only in config/labels/<label>.jsonc; this file
 * and the profile never duplicate each other.
 *
 * Key resolution of the long-standing ambiguity: GOOGLE_CLIENT_ID is an
 * api-var (not sensitive) and GOOGLE_CLIENT_SECRET is an api-secret.
 *
 * Field meanings:
 *   required      — must resolve non-empty for the label to be complete.
 *   requiredWhen  — conditionally required. "MAIL_DRIVER=resend" is active
 *                   when the var equals the value; "PAYMENTS_PROVIDERS~=stripe"
 *                   when the var is a provider list that names `stripe`.
 *                   Evaluated against the environment's resolved vars (the
 *                   profile plus the committed env.<label> Worker block).
 *   derivedFrom   — coherence anchor ("apiHost" | "webOrigin"); the value
 *                   is re-derived from the profile and diffed on check.
 *   from          — non-anchor source ("brand" | "r2").
 *   enum          — allowed literal values.
 *   policy        — named policy rule applied at check time.
 *   manual        — a human action the value implies (e.g. OAuth redirect).
 *   check         — how cf-resources presence is probed (by name).
 *   confirm       — the external manual-confirmation statement.
 */
{
  "build": {
    "NEXT_PUBLIC_API_URL":           { "required": true,  "derivedFrom": "apiHost" },
    // The origin the web app itself is served from, baked into sitemap.xml,
    // robots.txt's Sitemap: line, og:url and the canonical tags. Required:
    // unset, the build falls back to http://localhost:3000 and a deployed
    // tenant publishes a sitemap pointing at loopback (RFC 0014 section 7).
    "NEXT_PUBLIC_SITE_URL":          { "required": true,  "derivedFrom": "webOrigin" },
    "NEXT_PUBLIC_LANGUAGE":          { "required": false, "enum": ["pt", "en"] },
    "NEXT_PUBLIC_BRAND_SIGLA":       { "required": true,  "from": "brand" },
    "NEXT_PUBLIC_BRAND_NAME_PREFIX": { "required": true,  "from": "brand" },
    "NEXT_PUBLIC_BRAND_NAME_ACCENT": { "required": false, "from": "brand" },
    "NEXT_PUBLIC_BRAND_POWERED_BY":  { "required": false, "from": "brand", "enum": ["", "true", "false"] },
    "NEXT_PUBLIC_BRAND_ACCENT":      { "required": false, "from": "brand" },
    // Public WhatsApp number in international digits (e.g. 5519999991155). When
    // set, the landing page swaps its placeholder pricing CTAs for click-to-chat
    // contact buttons; unset ⇒ the CTAs stay disabled ("Em breve").
    "NEXT_PUBLIC_BRAND_WHATSAPP":    { "required": false, "from": "brand" }
  },
  "api-vars": {
    "ALLOWED_ORIGINS":     { "required": true,  "derivedFrom": "webOrigin", "policy": "no-wildcard-in-prod-staging" },
    "WEB_BASE_URL":        { "required": true,  "derivedFrom": "webOrigin" },
    "GOOGLE_REDIRECT_URI": { "required": true,  "derivedFrom": "apiHost", "manual": "register in the label's Google OAuth client" },
    "GOOGLE_CLIENT_ID":    { "required": true },
    "COOKIE_SAMESITE":     { "required": true,  "enum": ["Strict", "Lax", "None"] },
    "R2_S3_ENDPOINT":      { "required": true,  "from": "r2" },
    "R2_BUCKET_NAME":      { "required": true,  "from": "r2" },
    "R2_PUBLIC_BASE":      { "required": false, "from": "r2" },
    "MAIL_DRIVER":         { "required": true,  "enum": ["resend", "console", ""] },
    "MAIL_FROM":           { "required": true },
    // Student submissions (RFC 0020 section 3). Optional: absent takes the
    // default from packages/shared/domain/submissions/limits.ts. The schema has
    // no integer rule, so the three numeric vars are guarded at runtime by
    // apps/api/src/core/submissions/config.ts (present but invalid = 500).
    "SUBMISSIONS_PER_TOPIC_MAX":             { "required": false },
    "SUBMISSIONS_STORAGE_PER_STUDENT_BYTES": { "required": false },
    "SUBMISSIONS_VIDEO_MAX_BYTES":           { "required": false },
    "SUBMISSIONS_SHARING_ENABLED":           { "required": false, "enum": ["true", "false"] },
    // Payment gateway (RFC 0026 section 8). Optional: an absent PAYMENTS_PROVIDERS
    // means `none`, an absent PAYMENTS_KEY_MODE means `test`. The list is `none`
    // or comma-separated `provider:method+method` entries; the schema has no
    // rule for that grammar, so it is guarded at runtime by
    // apps/api/src/core/payments/config.ts (a list that breaks a rule, or a key
    // whose mode disagrees with PAYMENTS_KEY_MODE = 500 PAYMENTS_CONFIG_INVALID).
    // Neither var has a profile source: both live in the env.<label> Worker block.
    "PAYMENTS_PROVIDERS":                    { "required": false },
    "PAYMENTS_KEY_MODE":                     { "required": false, "enum": ["test", "live"] }
  },
  "api-secrets": {
    "JWT_SECRET":           { "required": true },
    "R2_ACCESS_KEY_ID":     { "required": true },
    "R2_SECRET_ACCESS_KEY": { "required": true },
    "GOOGLE_CLIENT_SECRET": { "required": true },
    // Gated by the mail driver: required only when MAIL_DRIVER=resend
    // (resolves the RFC's `required:true` + `requiredWhen` ambiguity to the
    // intended conditional gate).
    "RESEND_API_KEY":       { "required": false, "requiredWhen": "MAIL_DRIVER=resend" },
    // Payment providers (RFC 0026 section 8, R13). One pair per provider the
    // platform knows — the same four as PAYMENT_PROVIDER_NAMES in
    // packages/shared/ports/i-payment-gateway.ts (a test fails when the two
    // drift). A pair is required only while PAYMENTS_PROVIDERS names its
    // provider, a retired entry (`asaas:`) included. Externally valued: detected
    // by name and reported with the create-secrets.sh command, never generated
    // or written by provisioning. The Worker refuses a bound provider with
    // either secret absent (apps/api/src/core/payments/config.ts, rule 4).
    "PAYMENTS_STRIPE_SECRET_KEY":          { "required": false, "requiredWhen": "PAYMENTS_PROVIDERS~=stripe" },
    "PAYMENTS_STRIPE_WEBHOOK_SECRET":      { "required": false, "requiredWhen": "PAYMENTS_PROVIDERS~=stripe" },
    "PAYMENTS_MERCADOPAGO_SECRET_KEY":     { "required": false, "requiredWhen": "PAYMENTS_PROVIDERS~=mercadopago" },
    "PAYMENTS_MERCADOPAGO_WEBHOOK_SECRET": { "required": false, "requiredWhen": "PAYMENTS_PROVIDERS~=mercadopago" },
    "PAYMENTS_ASAAS_SECRET_KEY":           { "required": false, "requiredWhen": "PAYMENTS_PROVIDERS~=asaas" },
    "PAYMENTS_ASAAS_WEBHOOK_SECRET":       { "required": false, "requiredWhen": "PAYMENTS_PROVIDERS~=asaas" },
    "PAYMENTS_PAGARME_SECRET_KEY":         { "required": false, "requiredWhen": "PAYMENTS_PROVIDERS~=pagarme" },
    "PAYMENTS_PAGARME_WEBHOOK_SECRET":     { "required": false, "requiredWhen": "PAYMENTS_PROVIDERS~=pagarme" }
  },
  "cf-resources": {
    "worker":       { "check": "wrangler deployments / name" },
    "pagesProject": { "check": "wrangler pages project list" },
    "d1":           { "check": "wrangler d1 list" },
    "kv":           { "check": "wrangler kv namespace list" },
    "r2":           { "check": "wrangler r2 bucket list" },
    // Off-database backups (RFC 0025). Production only: staging is disposable
    // (RFC 0021 section 4), so a staging profile declares no backup block and
    // the provisioner creates no backup bucket for it.
    "backup":       { "check": "wrangler r2 bucket list", "requiredFor": ["production"] }
  },
  // The `backup` block of a profile environment (`environments.<env>.backup`):
  // the bucket the backup workflow writes to and the retention values the
  // backup scripts read. Keys are paths inside the block. `validateProfile`
  // (scripts/label.mjs) requires the block for every env listed in
  // cf-resources.backup.requiredFor and checks its keys for any env that
  // declares it.  type — "string" (non-empty) | "positive-integer".
  "backup": {
    "bucket":                  { "required": true, "type": "string", "convention": "<label>-backups" },
    // Lifecycle rule on the bucket: d1/<env>/daily/ objects expire after this many days.
    "retention.dailyDays":     { "required": true, "type": "positive-integer" },
    // Lifecycle rule on the bucket: d1/<env>/monthly/ objects expire after this many months.
    "retention.monthlyMonths": { "required": true, "type": "positive-integer" },
    // Read by the R2 mirror: a deleted media object is kept this many days before it is purged.
    "retention.tombstoneDays": { "required": true, "type": "positive-integer" }
  },
  "external": {
    "google-oauth": { "confirm": "Web OAuth client created; <GOOGLE_REDIRECT_URI> is an Authorised redirect URI" },
    "dns":          { "confirm": "Custom domains for <apiHost> and <webOrigin> resolve / are attached" },
    "resend":       { "confirm": "Sender domain of <MAIL_FROM> verified in Resend", "requiredWhen": "MAIL_DRIVER=resend" },
    // Webhook registration (RFC 0026 section 8): an operator step in each bound
    // provider's dashboard, per label and environment. Nothing here can see the
    // provider's side, so it is a confirmation, never a probe.
    "payments-webhook-stripe":      { "confirm": "Webhook registered in the Stripe dashboard: https://<apiHost>/v1/webhooks/payments/stripe", "requiredWhen": "PAYMENTS_PROVIDERS~=stripe" },
    "payments-webhook-mercadopago": { "confirm": "Webhook registered in the Mercado Pago dashboard: https://<apiHost>/v1/webhooks/payments/mercadopago", "requiredWhen": "PAYMENTS_PROVIDERS~=mercadopago" },
    "payments-webhook-asaas":       { "confirm": "Webhook registered in the Asaas dashboard: https://<apiHost>/v1/webhooks/payments/asaas", "requiredWhen": "PAYMENTS_PROVIDERS~=asaas" },
    "payments-webhook-pagarme":     { "confirm": "Webhook registered in the Pagar.me dashboard: https://<apiHost>/v1/webhooks/payments/pagarme", "requiredWhen": "PAYMENTS_PROVIDERS~=pagarme" }
  }
}
