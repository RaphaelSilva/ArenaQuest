/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-14",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// Exact-match only — do not introduce wildcards without a security review.
		// See docs/product/backlog/cors/ for the full CORS policy contract.
		"ALLOWED_ORIGINS": "https://arenaquest-web.pages.dev",
		"COOKIE_SAMESITE": "Strict",
		"R2_S3_ENDPOINT": "https://ACCOUNT_ID.r2.cloudflarestorage.com",
		"R2_PUBLIC_BASE": "",
		"R2_BUCKET_NAME": "arenaquest-media",
		// Mail + activation config (Task 02). RESEND_API_KEY is a secret —
		// set with `wrangler secret put RESEND_API_KEY`.
		"MAIL_DRIVER": "resend",
		"MAIL_FROM": "ArenaQuest <noreply@arenaquest.app>",
		"WEB_BASE_URL": "https://arenaquest-web.pages.dev",
		"GOOGLE_REDIRECT_URI": "https://api.arenaquest.app/auth/google/callback"
	},
	/**
	 * D1 Databases
	 * https://developers.cloudflare.com/d1/get-started/
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "arenaquest-db",
			"database_id": "148eaf0b-b615-4e0d-83c0-8d8c681061e4",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * KV Namespaces
	 * https://developers.cloudflare.com/kv/
	 *
	 * `RATE_LIMIT_KV` backs the login rate-limiter (S-04). Create the
	 * production namespace with: `wrangler kv:namespace create RATE_LIMIT_KV`.
	 */
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT_KV",
			"id": "c697147935024190ada81e743c3479d9"
		}
	],
	/**
	 * R2 Object Storage
	 * https://developers.cloudflare.com/r2/
	 *
	 * Create the production bucket: `wrangler r2 bucket create arenaquest-media`
	 * Secrets (set via `wrangler secret put`): R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
	 */
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "arenaquest-media"
		}
	],
	/**
	 * Environments
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environments
	 *
	 * "staging" is deployed from the develop branch (CI).
	 * "production" (default, no env flag) is deployed from the main branch.
	 */
	"env": {
		// >>> label:budo (generated) >>>
		"budo-staging": {
		  "name": "api-budo-staging",
		  "d1_databases": [
		    {
		      "binding": "DB",
		      "database_name": "budo-db-staging",
		      "database_id": "314fa333-c39e-478b-90a9-c09625420744",
		      "migrations_dir": "migrations"
		    }
		  ],
		  "kv_namespaces": [
		    {
		      "binding": "RATE_LIMIT_KV",
		      "id": "c75ab14e35164e22b7c6eb3581969295"
		    }
		  ],
		  "r2_buckets": [
		    {
		      "binding": "R2",
		      "bucket_name": "budo-media-staging"
		    }
		  ],
		  "vars": {
		    "ALLOWED_ORIGINS": "https://budo-web-staging.pages.dev,https://*.budo-web-staging.pages.dev,http://localhost:3000",
		    "COOKIE_SAMESITE": "None",
		    "R2_S3_ENDPOINT": "https://1d2505ce8bda0a19b128ae074c38ee1a.r2.cloudflarestorage.com",
		    "R2_PUBLIC_BASE": "",
		    "R2_BUCKET_NAME": "budo-media-staging",
		    "MAIL_DRIVER": "resend",
		    "MAIL_FROM": "Budo Staging <noreply@budo.app>",
		    "WEB_BASE_URL": "https://budo-web-staging.pages.dev",
		    // "GOOGLE_CLIENT_ID": it was setted manually in Cloudflare dashboard, because we don't want to expose it in the repo.
		    "GOOGLE_REDIRECT_URI": "https://api-budo-staging.spaziord.com.br/auth/google/callback"
		  },
		  "observability": {
		    "enabled": true,
		    "logs": {
		      "enabled": true
		    }
		  }
		},
		"budo": {
		  "name": "api-budo",
		  "d1_databases": [
		    {
		      "binding": "DB",
		      "database_name": "budo-db",
		      "database_id": "9cadb9ea-9a8b-4f85-a1c9-5dcb7c3a0b1a",
		      "migrations_dir": "migrations"
		    }
		  ],
		  "kv_namespaces": [
		    {
		      "binding": "RATE_LIMIT_KV",
		      "id": "8490968f05aa41a0a0abd57f7551e63d"
		    }
		  ],
		  "r2_buckets": [
		    {
		      "binding": "R2",
		      "bucket_name": "budo-media"
		    }
		  ],
		  "vars": {
		    "ALLOWED_ORIGINS": "https://app.budo.app",
		    "COOKIE_SAMESITE": "Strict",
		    "R2_S3_ENDPOINT": "https://1d2505ce8bda0a19b128ae074c38ee1a.r2.cloudflarestorage.com",
		    "R2_PUBLIC_BASE": "",
		    "R2_BUCKET_NAME": "budo-media",
		    "MAIL_DRIVER": "resend",
		    "MAIL_FROM": "Budo <noreply@budo.app>",
		    "WEB_BASE_URL": "https://app.budo.app",
		    // "GOOGLE_CLIENT_ID": it was setted manually in Cloudflare dashboard, because we don't want to expose it in the repo.
		    "GOOGLE_REDIRECT_URI": "https://api-budo.spaziord.com.br/auth/google/callback"
		  },
		  "observability": {
		    "enabled": true,
		    "logs": {
		      "enabled": true
		    }
		  }
		},
		// <<< label:budo <<<
		// >>> label:spaziord (generated) >>>
		"spaziord-staging": {
		  "name": "api-spaziord-staging",
		  "d1_databases": [
