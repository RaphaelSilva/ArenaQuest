		    "COOKIE_SAMESITE": "None",
		    "R2_S3_ENDPOINT": "https://1d2505ce8bda0a19b128ae074c38ee1a.r2.cloudflarestorage.com",
		    "R2_PUBLIC_BASE": "",
		    "R2_BUCKET_NAME": "spaziord-media-staging",
		    "MAIL_DRIVER": "resend",
		    "MAIL_FROM": "SpazioRD Staging <noreply@spaziord.app>",
