# ArenaQuest — QA test accounts for the `qa` skill and the E2E suite.
#
# Copy to `.envs.test` and fill it in. `.envs.test` is gitignored and must
# never be committed; this example carries placeholders only. The values are
# the local seed accounts of apps/api/migrations/seed/0001_test_users.sql
# (their passwords are documented in that file's header), or any account you
# created on your local replica. Never a staging or production account.

# Local dev URLs (override only if you run on non-default ports)
QA_WEB_URL=http://localhost:3000
QA_API_URL=http://localhost:8787

# One account per role of packages/shared/constants/roles.ts.
# They must exist in the local D1: `make db-migrate-local && make db-seed-local`.
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

QA_CONTENT_CREATOR_EMAIL=
QA_CONTENT_CREATOR_PASSWORD=

QA_TUTOR_EMAIL=
QA_TUTOR_PASSWORD=

QA_STUDENT_EMAIL=
QA_STUDENT_PASSWORD=

# Optional: a fresh, unregistered e-mail for the register flow
QA_NEW_USER_EMAIL=
QA_NEW_USER_PASSWORD=
